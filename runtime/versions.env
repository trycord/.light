# .light universal runtime image — pinned build inputs.
# Every value is an exact, tested version. The platform never substitutes a
# different runtime version at provision time.
DEBIAN_BASE=debian:bookworm-slim
DEBIAN_SUITE=bookworm
IMAGE_VERSION=1.0.0

NODE_VERSION=22.14.0
BUN_VERSION=1.2.2
DENO_VERSION=2.0.0
PYTHON_VERSION=3.12.9
JAVA_VERSION=17
DOTNET_VERSION=8.0.13
GO_VERSION=1.23.6
RUST_VERSION=1.84.1
ZIG_VERSION=0.13.0
SWIFT_VERSION=5.10.1
# Debian bookworm apt-provided versions (pinned by the base image snapshot):
PHP_VERSION=8.2
RUBY_VERSION=3.1
LUA_VERSION=5.4
PERL_VERSION=5.36
ELIXIR_VERSION=1.14
ERLANG_VERSION=25
GCC_VERSION=12
