# .light self-hosted configuration
# Everything is configurable by the system administrator.

NODE_ENV=production
PORT=5858
HOST=0.0.0.0
CONTROL_PLANE_PORT=5858
LOG_LEVEL=info
LT_MODE=all

# Secrets (auto-generated on first start if left blank)
JWT_SECRET=
NODE_TOKEN=

# Initial administrator
BOOTSTRAP_ADMIN_EMAIL=admin@trycord.dev
BOOTSTRAP_ADMIN_PASSWORD=LightAdmin2026!
BOOTSTRAP_ADMIN_NAME=trycord_administrator
ALLOW_SIGNUP=true

# Universal domain (project subdomains: <project>.trycord.dev)
PLATFORM_DOMAIN=trycord.dev
CONTROL_BASE_URL=https://trycord.dev

# Branding — fully customizable by the self-hoster
BRAND_PRODUCT=.light
BRAND_OWNER=Trycord
BRAND_ATTRIBUTION=.light is a Trycord product
BRAND_TAGLINE=Universal hosting platform
BRAND_SUPPORT_EMAIL=support@trycord.dev
BRAND_PRIMARY_COLOR=#FF4D24
BRAND_ACCENT_COLOR=#4C9B8A
BRAND_MARK=ΔΓΟ
BRAND_FAVICON=/assets/logos/favicon.svg
BRAND_LOGO=/assets/logos/light-primary.svg
BRAND_WORDMARK=/assets/logos/light-wordmark.svg
BRAND_BACKGROUND=/assets/backgrounds/volcanic-strata-16x9.svg
BRAND_DOC_TITLE=.light — Trycord Hosting

# Agent
LIGHT_NODE_ID=node-01
CONTROL_URL=http://127.0.0.1:5858
AGENT_PORT=5859
AGENT_DATA_DIR=/var/lib/trycord-light

# Storage (optional overrides)
DATABASE_PATH=./data/trycord-light.db
DATA_DIR=./data
NODE_ID=node-01

# Email (opt-in)
EMAIL_ENABLED=false
EMAIL_PROVIDER=deomail
DEOMAIL_API_KEY=
DEOMAIL_FROM_EMAIL=
DEOMAIL_API_URL=https://api.deomail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=true

# Universal runtime image (custom mode uses our Debian image)
LIGHT_RUNTIME_IMAGE_MODE=approved
LIGHT_RUNTIME_IMAGE=trycord/light-runtime
LIGHT_RUNTIME_IMAGE_VERSION=1.0.0

# Cloudflare Tunnels for project subdomains (optional — honest config-required state when blank)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=

# Build Your Own Plan — optional, off by default. Plans are defined in the admin plan maker.
ALLOW_CUSTOM_PLANS=false

# Single sign-on (optional)
SSO_ENABLED=false
SSO_URL=
SSO_LABEL=Continue with SSO

# Payments (optional — leave blank for administrator-approved manual activation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub deployments (optional — OAuth app credentials)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_WEBHOOK_SECRET=

# Reverse proxy & TLS (optional — Caddy admin API for automatic config application)
CADDY_ADMIN_URL=
PLATFORM_IP=
